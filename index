 <p class="sub" style="margin-top:12px">${Y.length} seasons, ${C.length} categories and ${PL.length} different names.</p>
 <div class="grid2" style="margin-top:22px">
 <div class="card"><h3>Most titles</h3><div class="tw"><table><tr><th>Name</th><th>1st, 2nd, 3rd</th></tr>${top.map(p=>`<tr><td>${nl(p.n)}</td><td>${mm(p.m)}</td></tr>`).join('')}</table></div></div>
 <div class="card"><h3>Longest winning streaks</h3><div class="tw"><table><tr><th>Name</th><th>Category</th><th>Years</th></tr>${streaks().map(s=>`<tr><td>${nl(s.n)}</td><td>${E(s.c)}</td><td>${s.s}–${s.e} (${s.l})</td></tr>`).join('')}</table></div></div></div>
 <h3 style="margin-top:30px">${ly} podiums</h3><div class="pods">${catsOf(ly).slice(0,6).map(c=>`<div class="card"><h3>${E(c)}</h3>${pod(R[c][ly])}</div>`).join('')}</div>
 <p style="margin-top:12px"><button class="chip" data-go="years" data-y="${ly}">See all ${ly} categories</button></p>`}
function categories(){
 const c=S.c;const lead={};
 Object.values(R[c]).forEach(r=>r.forEach((i,k)=>{if(i>=0){(lead[N[i]]??=[0,0,0])[k]++}}));
 const L=Object.entries(lead).sort((a,b)=>b[1][0]-a[1][0]||b[1][1]-a[1][1]||b[1][2]-a[1][2]).slice(0,8);
 return `<h2>By category</h2><p class="lead">Pick a category to see the podium for every season it was run.</p>
 <div class="bar" role="group" aria-label="Category">${C.map(x=>`<button class="chip" aria-pressed="${x===c}" data-c="${E(x)}">${E(x)}</button>`).join('')}</div>
 <div class="grid2"><div class="card"><h3>${E(c)} winners by year</h3><div class="tw"><table><tr><th>Year</th><th><i class="d g"></i>1st</th><th><i class="d s"></i>2nd</th><th><i class="d b"></i>3rd</th></tr>
 ${yrsOf(c).map(y=>`<tr><td>${y}</td>${R[c][y].map(i=>`<td>${nl(nm(i))}</td>`).join('')}</tr>`).join('')}</table></div></div>
 <div class="card"><h3>Most successful</h3><div class="tw"><table><tr><th>Name</th><th>1st, 2nd, 3rd</th></tr>${L.map(([n,m])=>`<tr><td>${nl(n)}</td><td>${mm(m)}</td></tr>`).join('')}</table></div></div></div>`}
function years(){
 const y=S.y,i=Y.indexOf(y);
 return `<h2>By year</h2><p class="lead">Every category from a single season.</p>
 <div class="bar"><button class="step" data-yd="1" aria-label="Previous year" ${i>=Y.length-1?'disabled':''}>‹</button>
 <select class="sel" id="ysel" aria-label="Year">${Y.map(x=>`<option ${x===y?'selected':''}>${x}</option>`).join('')}</select>
 <button class="step" data-yd="-1" aria-label="Next year" ${i<=0?'disabled':''}>›</button></div>
 ${catsOf(y).length?'':'<p class="sub">No league results recorded for this year.</p>'}<div class="pods">${catsOf(y).map(c=>`<div class="card"><h3>${E(c)}</h3>${pod(R[c][y])}</div>`).join('')}</div>`}
function people(){
 const q=S.q.trim().toLowerCase(),p=S.p&&P[S.p];
 let h=`<h2>People</h2><p class="lead">Look up anyone who has made a podium.</p><input class="search" id="q1" list="names" value="${E(S.q)}" placeholder="Start typing a name" aria-label="Search people" autocomplete="off"><datalist id="names">${PL.map(x=>`<option value="${E(x.n)}">`).join('')}</datalist><div style="height:20px"></div>`;
 if(p){const ys=p.e.map(e=>e.y),by={};p.e.forEach(e=>(by[e.c]??=[]).push(e));
  h+=`<div class="card"><h2 style="margin-bottom:12px">${E(p.n)}</h2><div class="big">${mm(p.m)}</div>
  <p class="sub">${Object.keys(by).length} ${Object.keys(by).length===1?'category':'categories'}, ${Math.min(...ys)}–${Math.max(...ys)}</p>
  ${C.filter(c=>by[c]).map(c=>`<div class="row"><b>${E(c)}</b><div class="yrs">${by[c].sort((a,b)=>b.y-a.y).map(e=>`<span class="y"><i class="d ${'gsb'[e.p]}"></i>${e.y}</span>`).join('')}</div></div>`).join('')}</div>`}
 else{const L=(q?PL.filter(x=>x.n.toLowerCase().includes(q)):PL).slice(0,40);
  h+=`<div class="card"><h3>${q?'Matches':'Most titles'}</h3>${L.length?`<div class="tw"><table><tr><th>Name</th><th>1st, 2nd, 3rd</th></tr>${L.map(x=>`<tr><td>${nl(x.n)}</td><td>${mm(x.m)}</td></tr>`).join('')}</table></div>`:'<p class="sub">No winner found with that name. Check the spelling or try just a surname.</p>'}</div>`}
 return h}
function render(){
 document.getElementById('nav').innerHTML=TABS.map(([k,l])=>`<button data-go="${k}" ${S.v===k?'aria-current="page"':''}>${l}</button>`).join('');
 document.getElementById('app').innerHTML={overview,categories,years,people}[S.v]()+(S.v==='overview'?`<p class="note">Compiled from the club league tables, ${Y[Y.length-1]} to ${Y[0]}. People are matched by name, so two people who share a name appear together. Some seasons come from early snapshots or partial tables, and some years have no league data.</p>`:'');
 const q=document.getElementById('q0')||document.getElementById('q1');
 if(q)q.addEventListener('input',e=>{const v=e.target.value;if(P[v]){S.p=v;S.q=v;S.v='people';render();return}if(q.id==='q1'){S.q=v;S.p=null;const pos=e.target.selectionStart;render();const n=document.getElementById('q1');n.focus();n.setSelectionRange(pos,pos)}});
 const ys=document.getElementById('ysel');if(ys)ys.onchange=e=>{S.y=+e.target.value;render()}}
function go(v){S.v=v;if(v==='people'&&!S.p)S.q='';location.hash=v;render();scrollTo(0,0)}
document.addEventListener('click',e=>{
 const t=e.target.closest('button');if(!t)return;
 if(t.dataset.p){S.p=t.dataset.p;S.q=t.dataset.p;go('people');return}
 if(t.dataset.go){if(t.dataset.y)S.y=+t.dataset.y;go(t.dataset.go);return}
 if(t.dataset.c){S.c=t.dataset.c;render();return}
 if(t.dataset.yd){S.y=Y[Y.indexOf(S.y)+ +t.dataset.yd];render()}});
addEventListener('hashchange',()=>{const h=location.hash.slice(1);if(ID.includes(h)&&h!==S.v){S.v=h;render()}});
render();
</script>
</body>
</html>
